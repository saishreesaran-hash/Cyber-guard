# ==============================================================================
# Digital Fraud & Threat Defense Guard - Environment Configuration
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit the real .env file with secrets into version control.
# ==============================================================================

# VirusTotal API v3 Key (Get a free API key at https://www.virustotal.com/)
# If left empty or unset, the application operates in Offline Structural Heuristics mode.
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Supabase Project Credentials (Create a project at https://supabase.com/)
# If left unset, the dashboard stores scan logs safely in in-memory session history.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Optional: Path to Tesseract OCR executable on Windows
# Linux / Docker containers have tesseract installed on system PATH by default.
# Example Windows path:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
